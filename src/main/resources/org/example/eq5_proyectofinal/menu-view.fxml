        <VBox alignment="CENTER" prefHeight="300.0" prefWidth="550.0" spacing="20.0" style="-fx-background-color: #333333; -fx-padding: 30; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 15, 0, 0, 5);">
