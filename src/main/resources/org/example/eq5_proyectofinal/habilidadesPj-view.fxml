<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootHP" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="550.0" prefWidth="750.0" style="-fx-background-color: #333333;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.eq5_proyectofinal.controlers.habilidadPersonajeController">

    <!-- =============================== -->
    <!--        TOP: CABECERA           -->
    <!-- =============================== -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="20.0" style="-fx-background-color: #1a1a1a;">
            <children>
                <Label fx:id="cabeceraPersonaje" text="Personaje [ID] | [Nombre]" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <HBox.margin>
                        <Insets left="15.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>
    </top>

    <!-- =============================== -->
    <!--              CENTER             -->
    <!-- =============================== -->

    <center>
        <HBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #333333;">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <!-- LEFT -->
            <VBox prefWidth="350">
                <children>

                    <Label fx:id="tituloPersonaje" text="Habilidades de [Nombre Personaje]" textFill="WHITE">
                        <font><Font name="System Bold" size="18.0" /></font>
                        <VBox.margin><Insets bottom="10" /></VBox.margin>
                    </Label>

                    <TableView fx:id="tablaHabilidadesPersonaje" prefHeight="400" style="-fx-background-color: #555555; -fx-text-fill: #FFFFFF;">
                        <columns>
                            <TableColumn fx:id="columnaHabilidad" prefWidth="150" text="Habilidad" />
                            <TableColumn fx:id="columnaNivel" prefWidth="100" text="Nivel" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER" spacing="10">
                        <padding><Insets top="10" /></padding>
                        <children>
                            <Button mnemonicParsing="false" onAction="#eliminarHabilidad" prefWidth="100" style="-fx-background-color: #e63946;" text="Remover" textFill="WHITE">
                                <font><Font name="System Bold" size="12.0" /></font>
                            </Button>
                        </children>
                    </HBox>

                </children>
            </VBox>

            <!-- RIGHT -->
            <VBox prefWidth="330">
                <children>

                    <Label text="Asignar Nueva Habilidad" textFill="#a8dadc">
                        <font><Font name="System Bold" size="16.0" /></font>
                        <VBox.margin><Insets bottom="10" /></VBox.margin>
                    </Label>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <children>
                            <Label prefWidth="100" text="Habilidad:" textFill="WHITE" />
                            <ComboBox fx:id="habilidadComboBox" prefWidth="180" promptText="Seleccionar..." />
                        </children>
                        <VBox.margin><Insets bottom="10" /></VBox.margin>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <children>
                            <Label prefWidth="100" text="Nivel (1-10):" textFill="WHITE" />
                            <TextField fx:id="nivelText" prefWidth="80" promptText="Nivel" />
                        </children>
                        <VBox.margin><Insets bottom="20" /></VBox.margin>
                    </HBox>

                    <Button mnemonicParsing="false" onAction="#asignarHabilidad" prefWidth="140" style="-fx-background-color: #f4d35e;" text="Asignar" textFill="#333333">
                        <font><Font name="System Bold" size="12.0" /></font>
                        <VBox.margin><Insets bottom="20" /></VBox.margin>
                    </Button>

                    <Button mnemonicParsing="false" onAction="#cerrar" prefWidth="140" style="-fx-background-color: #555555;" text="Volver" textFill="WHITE">
                        <font><Font name="System Bold" size="12.0" /></font>
                    </Button>

                </children>
            </VBox>

        </HBox>
    </center>

</BorderPane>
