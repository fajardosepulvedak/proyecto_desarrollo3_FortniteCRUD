<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="700.0" spacing="20.0" style="-fx-background-color: #1a1a1a;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gamecrud.controllers.MenuPrincipalController">
    <children>
        <Label text="DevTool | " textFill="WHITE">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
            <HBox.margin>
                <Insets left="15.0" />
            </HBox.margin>
        </Label>
        <Button mnemonicParsing="false" onAction="#abrirPersonajes" style="-fx-background-color: transparent; -fx-border-color: transparent;" text="🧍 Personajes" textFill="#457b9d">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
        <Button mnemonicParsing="false" onAction="#abrirArmas" style="-fx-background-color: transparent; -fx-border-color: transparent;" text="🔫 Armas" textFill="#a8dadc">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
        <Button mnemonicParsing="false" onAction="#abrirHabilidades" style="-fx-background-color: transparent; -fx-border-color: transparent;" text="✨ Habilidades" textFill="#e63946">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
        <Button mnemonicParsing="false" onAction="#abrirClases" style="-fx-background-color: transparent; -fx-border-color: transparent;" text="🛡️ Clases" textFill="#f4d35e">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
    </children>
</HBox>